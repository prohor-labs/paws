{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "paths": {
      "@paws/sdk": ["../sdk/src/index.ts"],
      "@paws/sdk/schemas": ["../sdk/src/schemas/index.ts"],
      "@paws/sdk/server": ["../sdk/src/server/index.ts"]
    }
  },
  "include": ["src/**/*", "drizzle.config.ts"]
}
