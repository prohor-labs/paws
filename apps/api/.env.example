# Server
NODE_ENV=development
PORT=7000
HOST=0.0.0.0

# Database (required in production; defaults to local Postgres in development)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pawfessor
DIRECT_URL=
DB_MAX_CONNECTIONS=30
# Set to true only when the connection is not behind a transaction-mode pooler.
DB_PREPARE=false

# Auth (secret is required in production)
BETTER_AUTH_URL=http://localhost:7000
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Web app + CORS
NEXT_PUBLIC_APP_URL=http://localhost:7001
TRUSTED_ORIGINS=http://localhost:7001

# Storage (S3 compatible)
AWS_REGION=auto
AWS_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=pawfessor
AWS_PUBLIC_URL=
AWS_FORCE_PATH_STYLE=false

# Uploads
UPLOAD_MAX_BYTES=10485760

# AI / LLM
GROQ_API_KEY=
OPENAI_API_KEY=
