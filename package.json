{
  "name": "paws.academy",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:https": "turbo run dev:https",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "graphify": "graphify .",
    "graphify:apps": "graphify apps/",
    "graphify:update": "graphify --update"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.9",
    "prettier": "3.9.6",
    "turbo": "^2.11.6",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
