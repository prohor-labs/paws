{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    "apps/api": {
      "entry": [
        "src/index.ts",
        "src/db/flush.ts",
        "src/db/seed-qb.ts",
        "src/db/clear-qb.ts",
        "src/db/migrate-qb.ts",
        "src/db/migrate-container-category.ts",
        "src/db/migrate-topics-hierarchy.ts",
        "src/scripts/**/*.ts"
      ],
      "ignore": [
        "src/db/**"
      ],
      "project": ["src/**/*.ts"]
    },
    "apps/web": {
      "next": true,
      "entry": [
        "src/app/**/{page,layout,loading,error,not-found,route,template,default}.{ts,tsx}",
        "src/components/ui/*.tsx",
        "src/components/qb/index.ts",
        "src/components/shared/index.ts",
        "src/components/exam/index.ts",
        "src/lib/sdk/index.ts",
        "src/lib/sdk/server.ts"
      ],
      "project": ["src/**/*.{ts,tsx,css}"]
    },
    "apps/sdk": {
      "entry": ["tests/**/*.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    }
  }
}
